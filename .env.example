# ── Required ──────────────────────────────────────────────────────────────
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Canonical public URL. Share links, QR codes and auth callbacks use it.
APP_URL=http://localhost:3000
# Optional: a separate address for the public website (home page), with the app (sign-in, dashboard)
# staying on APP_URL. Example: SITE_URL=https://evermore.example and APP_URL=https://app.evermore.example
# SITE_URL=

# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, RDS…). Leave unset in development to use an
# embedded Postgres (PGlite) stored in ./data/pglite. Required in production.
DATABASE_URL=

# ── Email (optional in development) ───────────────────────────────────────
# Without a key, emails are written to ./data/outbox and printed in the terminal instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="EverMore <hello@your-domain.com>"

# ── Google sign-in (optional) ─────────────────────────────────────────────
# Redirect URI to register: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads

# ── Security & operations ─────────────────────────────────────────────────
# Header your proxy/CDN sets with the real client IP (e.g. cf-connecting-ip). Unset when not behind one.
TRUSTED_IP_HEADER=
# Secret for the scheduled jobs endpoint (anniversary reminders). 16+ characters.
CRON_SECRET=

# Payments by Mobile Money (MTN, Telecel, AirtelTigo) or card, via Paystack (https://paystack.com).
# Use an sk_test_ key while testing. Add https://<your app address>/api/paystack/webhook as the webhook
# URL in the Paystack dashboard.
PAYSTACK_SECRET_KEY=
# "true" turns charging on: hosts build and preview for free, and pay once per celebration to publish
# (price in src/lib/plans.ts). Pages that are already live go offline until their host pays. Needs
# PAYSTACK_SECRET_KEY. Until then pages publish without payment.
BILLING_ENABLED=
# "true" lets guests give online through Paystack. The money arrives in your Paystack account, so only
# turn it on if you pay hosts out. Off: guests see the host's MoMo details and hosts confirm gifts by hand.
ONLINE_GIFTS_ENABLED=

# ── AI drafting (optional) ────────────────────────────────────────────────
# Adds a "Describe your event" box to the details step: hosts type one sentence and the empty fields
# are drafted for them to review. Unset: the box is hidden. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_DRAFT_MODEL=claude-haiku-5-5
