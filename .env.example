# ── Required ──────────────────────────────────────────────────────────────
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Canonical public URL. Share links, QR codes and auth callbacks use it.
APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, RDS…). Leave unset in development to use an
# embedded Postgres (PGlite) stored in ./data/pglite. Required in production.
DATABASE_URL=

# ── Email (optional in development) ───────────────────────────────────────
# Without a key, emails are written to ./data/outbox and printed in the terminal instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="EverMore <hello@your-domain.com>"

# ── Google sign-in (optional) ─────────────────────────────────────────────
# Redirect URI to register: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads

# ── Security & operations ─────────────────────────────────────────────────
# Header your proxy/CDN sets with the real client IP (e.g. cf-connecting-ip). Unset when not behind one.
TRUSTED_IP_HEADER=
# Secret for the scheduled jobs endpoint (anniversary reminders). 16+ characters.
CRON_SECRET=
